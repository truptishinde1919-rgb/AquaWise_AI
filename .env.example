# ==========================================
# AquaWise AI - Environment Variables Template
# ==========================================
# Copy this file to .env (for local backend development)
# and frontend/.env.local (for local frontend development).
# DO NOT put real production secrets or API keys in this template!

# Backend Configuration (FastAPI)
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,https://aquawise-ai.vercel.app

# Backend-only agricultural research chatbot settings
# Keep the API key only in the backend environment (local backend/.env or Render).
OPENAI_API_KEY=
# PostgreSQL database with the pgvector extension enabled.
DATABASE_URL=
# Minimum cosine similarity (0-1) for research chunks to count as evidence.
RAG_MIN_SIMILARITY=0.2

# Frontend Configuration (Next.js)
# URL pointing to the FastAPI backend API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
